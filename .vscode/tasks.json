{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Derle",
            "type": "shell",
            "command": "javac",
            "args": [
                "-cp", "${workspaceFolder}/lib/Enigma-Edited2.jar",
                "-d", "${workspaceFolder}/bin",
                "${workspaceFolder}/src/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$javac"
        }
    ]
}
